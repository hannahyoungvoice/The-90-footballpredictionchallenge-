
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#08111f">

  <title>THE 90 | Football Prediction Challenge</title>

  <meta name="description"
    content="Welcome to THE 90 Football Prediction Challenge. Learn the rules, explore Safe Zones, register and follow contestant progress.">

  <style>
    :root {
      --bg: #08111f;
      --panel: #101d30;
      --gold: #f6c453;
      --green: #19c37d;
      --white: #f8fafc;
      --muted: #a9b5c7;
      --border: #26364b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 85px;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--white);
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, a {
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      width: min(1120px, 92%);
      margin: auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(8, 17, 31, .97);
      border-bottom: 1px solid var(--border);
    }

    .navbar {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .logo {
      font-size: 27px;
      font-weight: 900;
      letter-spacing: 2px;
      color: var(--gold);
      white-space: nowrap;
    }

    .logo span {
      display: block;
      font-size: 9px;
      color: white;
      letter-spacing: 2px;
      line-height: 1;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 17px;
      font-size: 13px;
    }

    nav a:hover {
      color: var(--gold);
    }

    .menu-button {
      display: none;
      color: white;
      background: var(--panel);
      border: 1px solid var(--border);
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 20px;
    }

    .button {
      display: inline-block;
      border: 0;
      border-radius: 8px;
      padding: 13px 21px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      text-align: center;
      transition: .2s;
    }

    .button:hover {
      transform: translateY(-2px);
      filter: brightness(1.08);
    }

    .gold-button {
      background: var(--gold);
      color: #17130a;
    }

    .green-button {
      background: var(--green);
      color: #04170e;
    }

    .outline-button {
      border: 1px solid var(--border);
      color: white;
      background: transparent;
    }

    .hero {
      padding: 90px 0 80px;
      background:
        radial-gradient(ellipse at 80% 10%,
        rgba(25,195,125,.15), transparent 42%),
        radial-gradient(ellipse at 10% 90%,
        rgba(246,196,83,.10), transparent 40%);
    }

    .hero-content {
      max-width: 790px;
    }

    .eyebrow {
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 2px;
      font-weight: 800;
      font-size: 12px;
    }

    h1 {
      font-size: clamp(43px, 8vw, 78px);
      line-height: 1.08;
      margin: 18px 0;
      letter-spacing: -2px;
    }

    h1 span {
      color: var(--gold);
    }

    .hero p {
      color: var(--muted);
      max-width: 650px;
      font-size: 17px;
      margin-bottom: 25px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 25px 0;
    }

    .notice {
      margin-top: 24px;
      padding: 13px 16px;
      border-left: 3px solid var(--gold);
      background: rgba(246,196,83,.07);
      color: var(--muted);
      font-size: 12px;
      max-width: 690px;
    }

    section {
      padding: 72px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 35px;
    }

    .section-heading h2 {
      font-size: clamp(27px, 5vw, 39px);
      margin: 8px 0;
    }

    .section-heading p {
      color: var(--muted);
      max-width: 680px;
      margin: auto;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 23px;
    }

    .card h3 {
      color: var(--gold);
      margin-bottom: 9px;
      font-size: 19px;
    }

    .card p, .card li {
      color: var(--muted);
      font-size: 14px;
    }

    .step-number {
      width: 39px;
      height: 39px;
      border-radius: 10px;
      background: rgba(246,196,83,.12);
      color: var(--gold);
      display: grid;
      place-items: center;
      font-weight: 900;
      margin-bottom: 15px;
    }

    .prize-card {
      text-align: center;
    }

    .prize-card strong {
      display: block;
      font-size: 25px;
      color: var(--gold);
      margin: 7px 0;
    }

    .prize-card span {
      font-size: 12px;
      color: var(--muted);
    }

    .highlight {
      border-color: var(--gold);
    }

    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 12px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
      background: var(--panel);
    }

    th, td {
      padding: 14px;
      text-align: left;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
    }

    th {
      color: var(--gold);
      background: #142238;
    }

    td {
      color: var(--muted);
    }

    .status {
      color: var(--green);
      font-weight: 800;
    }

    .small-note {
      color: var(--muted);
      font-size: 12px;
      margin-top: 12px;
    }

    .register-panel {
      background: linear-gradient(135deg, #13263a, #101d30);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 35px;
      text-align: center;
    }

    .register-panel h2 {
      font-size: clamp(27px, 5vw, 39px);
      margin-bottom: 10px;
    }

    .register-panel p {
      color: var(--muted);
      max-width: 650px;
      margin: 0 auto 20px;
    }

    .payment-note {
      border: 1px solid var(--border);
      padding: 17px;
      border-radius: 10px;
      margin: 20px auto;
      max-width: 600px;
      text-align: left;
      color: var(--muted);
      font-size: 13px;
    }

    details {
      background: var(--panel);
      border: 1px solid var(--border);
      padding: 17px;
      border-radius: 10px;
      margin: 12px 0;
    }

    summary {
      cursor: pointer;
      font-weight: 700;
    }

    details p {
      color: var(--muted);
      margin-top: 10px;
      font-size: 14px;
    }

    footer {
      padding: 35px 0;
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: 12px;
      text-align: center;
    }

    footer .logo {
      margin-bottom: 12px;
    }

    .whatsapp {
      position: fixed;
      bottom: 20px;
      right: 18px;
      z-index: 90;
      border-radius: 30px;
      background: var(--green);
      color: #04170e;
      font-weight: 800;
      padding: 12px 17px;
      box-shadow: 0 5px 25px #0006;
      font-size: 13px;
    }

    @media (max-width: 800px) {
      .menu-button {
        display: block;
      }

      nav {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        width: 100%;
        padding: 20px 5%;
        background: #0b1728;
        border-bottom: 1px solid var(--border);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      nav.open {
        display: flex;
      }

      nav a {
        padding: 11px 0;
      }

      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .hero {
        padding: 65px 0;
      }

      section {
        padding: 55px 0;
      }
    }

    @media (max-width: 520px) {
      .grid {
        grid-template-columns: 1fr;
      }

      .hero-actions .button {
        width: 100%;
      }

      .register-panel {
        padding: 23px 16px;
      }

      h1 {
        letter-spacing: -1px;
      }
    }
  </style>
</head>

